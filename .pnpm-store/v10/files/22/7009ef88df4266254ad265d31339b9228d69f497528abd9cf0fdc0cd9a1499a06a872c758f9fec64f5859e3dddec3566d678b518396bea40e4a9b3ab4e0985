    sidebar?: boolean;
    outline?: boolean;
    footer?: boolean;
    lineNumbers?: boolean;
    overviewHeaders?: number[];
    titleSuffix?: string;
    head?: [string, Record<string, string>][];
    context?: string;
    [key: string]: unknown;
}

