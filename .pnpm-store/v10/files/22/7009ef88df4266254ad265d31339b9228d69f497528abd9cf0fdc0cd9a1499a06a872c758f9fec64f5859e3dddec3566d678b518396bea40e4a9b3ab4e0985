/**
 * @description search-index.json file
 * "_foo" is the private field that won't be written to search-index.json file
 * and should not be used in the runtime (usePageData).
 */
declare interface PageIndexInfo {
    routePath: string;
    title: string;
    toc: Header[];
    content: string;
